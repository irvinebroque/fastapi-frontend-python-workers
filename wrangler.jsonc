{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fastapi-frontend-python-workers",
	"main": "src/entry.py",
	"compatibility_date": "2026-06-20",
	"compatibility_flags": [
		"python_workers"
	],
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	}
}
